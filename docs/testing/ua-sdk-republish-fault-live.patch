+fn sdk_republish_fault(mode: u8) {
+    use opcua::client::{DataChangeCallback, RepublishRecoveryOutcome};
+    use opcua::types::{AttributeId, MonitoredItemCreateRequest, MonitoringMode, MonitoringParameters, ReadValueId, TimestampsToReturn};
+    use std::sync::atomic::Ordering;
+    let server = TestServer::start(free_port());
+    let proxy = DropPublishProxy::start(&server);
+    let rt = tokio::runtime::Builder::new_multi_thread().worker_threads(2).enable_all().build().unwrap();
+    rt.block_on(async {
+        let (events, event_rx) = channel();
+        let cancel = tokio_util::sync::CancellationToken::new();
+        let mut adapter = super::session::connect(SessionId::FIRST, Some(crate::bff::model::RequestId::FIRST), Harness::endpoint(&proxy.url), &cancel, &events).await.unwrap();
+        assert!(!adapter.session.republish_history_uncertain());
+        let mut recovery = adapter.session.subscribe_republish_recovery();
+        let (status_tx, status_rx) = channel();
+        let monitor = tokio::spawn(async move { while recovery.changed().await.is_ok() { let value = recovery.borrow_and_update().clone(); if let Some(v) = value { let _ = status_tx.send(v); } } });
+        let (value_tx, value_rx) = channel();
+        let callback = DataChangeCallback::new(move |value: DataValue, _| { let _ = value_tx.send(value); });
+        let sub = adapter.session.create_subscription(Duration::from_millis(100),100,20,1000,0,true,callback).await.unwrap();
+        let created = adapter.session.create_monitored_items(sub, TimestampsToReturn::Both, vec![MonitoredItemCreateRequest { item_to_monitor: ReadValueId { node_id: NodeId::new(server.ns,"Level"), attribute_id: AttributeId::Value as u32, ..Default::default() }, monitoring_mode: MonitoringMode::Reporting, requested_parameters: MonitoringParameters { client_handle: 1, sampling_interval: 0.0, queue_size: 10, discard_oldest: true, ..Default::default() } }]).await.unwrap();
+        assert!(created[0].result.status_code.is_good());
+        value_rx.recv_timeout(Duration::from_secs(15)).expect("initial callback");
+        proxy.fault_mode.store(mode, Ordering::SeqCst);
+        proxy.armed.store(true, Ordering::SeqCst);
+        server.set("Level", Variant::Double(52.5));
+        proxy.lost.recv_timeout(Duration::from_secs(15)).expect("initial value response dropped");
+        proxy.fault_seen.recv_timeout(Duration::from_secs(30)).expect("real Republish fault entered");
+        let wanted = if mode == 1 { RepublishRecoveryOutcome::Deadline } else { RepublishRecoveryOutcome::Cancelled };
+        let deadline = Instant::now() + Duration::from_secs(30);
+        let mut observed = Vec::new();
+        while Instant::now() < deadline && !observed.contains(&wanted) {
+            let Ok(status) = status_rx.recv_timeout(deadline.saturating_duration_since(Instant::now())) else { break };
+            observed.push(status);
+        }
+        assert!(observed.contains(&wanted), "expected {wanted:?}, observed {observed:?}");
+        assert!(adapter.session.republish_history_uncertain());
+        if mode == 1 {
+            let until = Instant::now() + Duration::from_secs(15);
+            let mut reconnected = false;
+            while Instant::now() < until {
+                let Ok(event) = event_rx.recv_timeout(until.saturating_duration_since(Instant::now())) else { break };
+                if matches!(event.kind, EventKind::UaRecovery { state: crate::bff::model::UaRecoveryState::Reconnected { .. } }) { reconnected = true; break; }
+            }
+            assert!(reconnected, "new remote scope not announced before late reply");
+            proxy.release.notify_one();
+            proxy.fault_seen.recv_timeout(Duration::from_secs(5)).expect("held response sent after scope transition");
+            assert!(value_rx.recv_timeout(Duration::from_secs(2)).is_err(), "late response delivered stale callback");
+            server.set("Level", Variant::Double(53.5));
+            let v = value_rx.recv_timeout(Duration::from_secs(20)).expect("owner did not continue");
+            assert_eq!(v.value, Some(Variant::Double(53.5)));
+        } else {
+            let v = value_rx.recv_timeout(Duration::from_secs(30)).expect("recovery after cut");
+            assert_eq!(v.value, Some(Variant::Double(52.5)));
+            assert!(value_rx.recv_timeout(Duration::from_secs(2)).is_err(), "duplicate replay after cancellation");
+            server.set("Level", Variant::Double(53.5));
+            let v = value_rx.recv_timeout(Duration::from_secs(20)).expect("owner did not continue");
+            assert_eq!(v.value, Some(Variant::Double(53.5)));
+        }
+        if mode == 2 {
+            let latest = adapter.session.subscribe_republish_recovery();
+            assert_eq!(*latest.borrow(), Some(RepublishRecoveryOutcome::MessageNotAvailable));
+            eprintln!("OBSERVED latest_watch=MessageNotAvailable after_cancelled");
+        }
+        assert!(adapter.session.republish_history_uncertain(), "latest successful value must not clear unknown history");
+        eprintln!("OBSERVED mode={mode} outcome={wanted:?} later=53.5 sticky_unknown=true");
+        adapter.close().await;
+        monitor.abort();
+    });
+}
+#[test]
+fn sdk_republish_delayed_reply_after_deadline() { sdk_republish_fault(1); }
+#[test]
+fn sdk_republish_transport_cut_during_request() { sdk_republish_fault(2); }
