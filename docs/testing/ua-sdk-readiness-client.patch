+struct ReplayCancellationGuard {
+    outcome: tokio::sync::watch::Sender<Option<RepublishRecoveryOutcome>>,
+    armed: bool,
+}
+impl Drop for ReplayCancellationGuard {
+    fn drop(&mut self) { if self.armed { self.outcome.send_replace(Some(RepublishRecoveryOutcome::Cancelled)); } }
+}
+fn next_recovery_generation(current: u64) -> Option<u64> { current.checked_add(1) }
+
