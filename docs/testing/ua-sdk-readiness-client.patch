+#[cfg(test)]
+mod recovery_ready_unit {
+    use super::*;
+    #[test]
+    fn generation_and_deadline_fence_confirmation() {
+        let now=std::time::Instant::now();
+        let (tx,_)=tokio::sync::watch::channel(RecoveryReadiness {generation:7, phase:RecoveryReadyPhase::Waiting, deadline:now+std::time::Duration::from_secs(1)});
+        assert!(!confirm_recovery_ready(&tx,6,now));
+        assert!(!confirm_recovery_ready(&tx,8,now));
+        assert!(!confirm_recovery_ready(&tx,7,now+std::time::Duration::from_secs(1)));
+        assert!(confirm_recovery_ready(&tx,7,now));
+        assert!(!confirm_recovery_ready(&tx,7,now));
+        tx.send_replace(RecoveryReadiness {generation:8,phase:RecoveryReadyPhase::Waiting,deadline:now+std::time::Duration::from_secs(1)});
+        assert!(!confirm_recovery_ready(&tx,7,now));
+        assert!(confirm_recovery_ready(&tx,8,now));
+    }
+}
