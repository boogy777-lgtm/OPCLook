+/// SDK recovery readiness phase. Waiting does not imply complete history.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RecoveryReadyPhase {
+    /// No confirmation is currently accepted.
+    Inactive,
+    /// A consumer may confirm the current generation.
+    Waiting,
+    /// Current generation was confirmed exactly once.
+    Confirmed,
+}
+/// Bounded readiness request; generation is scoped to this SDK Session object.
+#[derive(Clone, Copy, Debug)]
+pub struct RecoveryReadiness {
+    /// Monotonically increasing SDK-local generation.
+    pub generation: u64,
+    /// Whether this generation may be confirmed.
+    pub phase: RecoveryReadyPhase,
+    /// Latest time at which confirmation is accepted.
+    pub deadline: std::time::Instant,
+}
+fn confirm_recovery_ready(tx: &tokio::sync::watch::Sender<RecoveryReadiness>, generation: u64, now: std::time::Instant) -> bool {
+    let mut accepted = false;
+    tx.send_if_modified(|state| {
+        if state.generation == generation && state.phase == RecoveryReadyPhase::Waiting && now < state.deadline {
+            state.phase = RecoveryReadyPhase::Confirmed; accepted = true; true
+        } else { false }
+    });
+    accepted
+}
