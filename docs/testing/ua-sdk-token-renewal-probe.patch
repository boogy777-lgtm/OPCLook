+        assert!(items[0].result.status_code.is_good());let monitored_id=items[0].result.monitored_item_id;
+        rx.recv_timeout(Duration::from_secs(15)).expect("initial secured subscription value");
+        let until=Instant::now()+Duration::from_secs(30);let mut next_token=None;
+        while Instant::now()<until && next_token.is_none() {
+            let read=adapter.session.read(&[node.clone()],TimestampsToReturn::Both,0.0).await.expect("Read during renewal");assert_eq!(read[0].value,Some(Variant::Double(1.0)));
+            while let Ok((sock,ch,token))=proxy.frames.try_recv() {if sock==socket && ch==channel_id && token!=first_token && token!=0 {next_token=Some(token);break}}
+            tokio::time::sleep(Duration::from_millis(200)).await;
+        }
+        let second_token=next_token.expect("SDK did not send a renewed token on original channel");
+        assert_ne!(first_token,second_token);assert_eq!(adapter.session.server_session_id(),remote);
+        {
+            let state=adapter.session.subscription_state.lock();
+            let subscription=state.get(sub).expect("same SDK subscription after token renewal");
+            assert!(subscription.monitored_items().any(|item| item.id()==monitored_id && item.client_handle()==1), "same SDK monitored item after token renewal");
+        }
+        server.set("Level",Variant::Double(54.5));let limit=Instant::now()+Duration::from_secs(15);let mut pushed=false;
+        while Instant::now()<limit {let Ok(v)=rx.recv_timeout(limit.saturating_duration_since(Instant::now())) else {break};if v.value==Some(Variant::Double(54.5)){pushed=true;break}}
+        assert!(pushed,"same SDK subscription did not deliver after token change");
+        let after=adapter.session.read(&[node],TimestampsToReturn::Both,0.0).await.expect("secured Read after renewal");assert_eq!(after[0].value,Some(Variant::Double(54.5)));
+        assert_eq!(adapter.session.server_session_id(),remote);
+        assert!(!event_rx.try_iter().any(|e|matches!((e.origin,e.kind),(Origin::UaSession {connection,..},EventKind::UaRecovery {state:UaRecoveryState::ConnectionLost {..}}) if connection==epoch)),"unexpected loss during renewal");
+        eprintln!("OBSERVED policy=Basic256Sha256 mode=SignAndEncrypt verify=true channel={channel_id} token_before={first_token} token_after={second_token} same_session=true sub={sub} item={monitored_id} fresh=54.5 push=54.5");
+        adapter.close().await;
+    });
