+        assert!(matches!(&adapter.info,BackendMsg::UaConnected {policy,mode,protection:UaProtection::SignAndEncrypt,..} if policy=="Basic256Sha256" && mode=="SignAndEncrypt"));
+        let remote=adapter.session.server_session_id();
+        while proxy.frames.try_recv().is_ok() {}
+        let node=ReadValueId {node_id:NodeId::new(server.ns,"Level"),attribute_id:AttributeId::Value as u32,..Default::default()};
+        let before=adapter.session.read(&[node.clone()],TimestampsToReturn::Both,0.0).await.expect("initial secured Read");assert_eq!(before[0].value,Some(Variant::Double(1.0)));
+        let (socket,channel_id,first_token)=proxy.frames.recv_timeout(Duration::from_secs(5)).expect("secured MSG token header");assert_ne!(channel_id,0);assert_ne!(first_token,0);
+        let (tx,rx)=channel();let callback=DataChangeCallback::new(move |v:DataValue,_|{let _=tx.send(v);});
+        let sub=adapter.session.create_subscription(Duration::from_millis(100),100,20,1000,0,true,callback).await.unwrap();
