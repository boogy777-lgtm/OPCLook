+        let mut endpoint=Harness::endpoint(&proxy.url);endpoint.ua_security_policy=UaSecurityPolicy::Basic256Sha256;endpoint.ua_security_mode=UaSecurityMode::SignAndEncrypt;endpoint.ua_trust_server_cert=false;
