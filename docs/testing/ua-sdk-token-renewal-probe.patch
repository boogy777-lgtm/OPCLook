+        let (tx,frames)=channel();let (stop,stopped)=tokio::sync::oneshot::channel();
+        let thread=std::thread::spawn(move || {
+            use tokio::io::{AsyncReadExt,AsyncWriteExt};
+            let rt=tokio::runtime::Builder::new_multi_thread().worker_threads(2).enable_all().build().unwrap();
+            rt.block_on(async move {
+                let listener=tokio::net::TcpListener::from_std(listener).unwrap();let mut tasks=tokio::task::JoinSet::new();let mut next=0u64;tokio::pin!(stopped);
+                loop { tokio::select! {
+                    _=&mut stopped=>break,
+                    accept=listener.accept()=>{
+                        let Ok((client,_))=accept else {break};next+=1;let socket=next;let tx=tx.clone();
+                        tasks.spawn(async move {
+                            let Ok(server)=tokio::net::TcpStream::connect(("127.0.0.1",target)).await else {return};
+                            let (mut cr,mut cw)=client.into_split();let (mut sr,mut sw)=server.into_split();
+                            let forward=async move {loop {
+                                let mut h=[0u8;8];if cr.read_exact(&mut h).await.is_err(){break}
+                                let n=u32::from_le_bytes([h[4],h[5],h[6],h[7]]) as usize;
+                                if !(8..=1_048_576).contains(&n){break}let mut frame=vec![0;n];frame[..8].copy_from_slice(&h);if cr.read_exact(&mut frame[8..]).await.is_err(){break}
+                                if &h[..3]==b"MSG" && n>=16 {
+                                    let channel=u32::from_le_bytes(frame[8..12].try_into().unwrap());
+                                    let token=u32::from_le_bytes(frame[12..16].try_into().unwrap());
+                                    let _=tx.send((socket,channel,token));
+                                }
+                                if sw.write_all(&frame).await.is_err(){break}
+                            }};
+                            let backward=async move {let _=tokio::io::copy(&mut sr,&mut cw).await;};
+                            tokio::select!{_ = forward=>{},_ = backward=>{}}
+                        });
+                    }
+                }}tasks.abort_all();while tasks.join_next().await.is_some(){}
+            });
+        });
+        Self {url:format!("opc.tcp://127.0.0.1:{port}/"),frames,stop:Some(stop),thread:Some(thread)}
+    }
