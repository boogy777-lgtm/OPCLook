+    // Experimental owner-only bounded replay; see OPCLook diagnostic, not production ready.
+    pub(crate) async fn recovery_republish_prototype(&self) -> crate::session::RepublishRecoveryOutcome {
+        use crate::session::RepublishRecoveryOutcome as O;
+        const MAX_MESSAGES: usize = 256;
+        let cursors = {
+            let state = trace_lock!(self.subscription_state);
+            if state.recovery_uncertain() { return O::SequenceUncertain; }
+            state.recovery_cursors()
+        };
+        if cursors.is_empty() { return O::NoCursor; }
+        let mut remaining = MAX_MESSAGES;
+        for (id, last) in cursors {
+            let mut seq = if last == u32::MAX { 1 } else { last + 1 };
+            loop {
+                if remaining == 0 { return O::Exhausted; }
+                remaining -= 1;
+                match Republish::new(id, seq, self).send(&self.channel).await {
+                    Ok(response) if response.notification_message.sequence_number == seq => {
+                        trace_lock!(self.subscription_state).handle_notification(id, response.notification_message);
+                        seq = if seq == u32::MAX { 1 } else { seq + 1 };
+                    }
+                    Ok(_) => return O::SequenceMismatch,
+                    Err(error) if error.status() == StatusCode::BadMessageNotAvailable => break,
+                    Err(error) => return O::Failed(error.status()),
+                }
+            }
+        }
+        O::MessageNotAvailable
+    }
+
