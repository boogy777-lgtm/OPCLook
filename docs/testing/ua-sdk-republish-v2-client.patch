+const REORDER_WINDOW: usize = 64;
+#[derive(Default)]
+struct SequenceCursor {
+    contiguous: Option<u32>,
+    ahead: HashSet<u32>,
+    uncertain: bool,
+}
+impl SequenceCursor {
+    fn next(n: u32) -> u32 { if n == u32::MAX { 1 } else { n + 1 } }
+    fn observe(&mut self, seq: u32) -> bool {
+        if seq == 0 { self.uncertain = true; return true; }
+        let Some(last) = self.contiguous else { self.contiguous = Some(seq); return true; };
+        let distance = if seq >= last { u64::from(seq - last) } else { u64::from(u32::MAX - last) + u64::from(seq) };
+        if distance == 0 || distance > u64::from(u32::MAX) / 2 { return false; }
+        if distance == 1 {
+            let mut n = seq;
+            while self.ahead.remove(&Self::next(n)) { n = Self::next(n); }
+            self.contiguous = Some(n);
+            return true;
+        }
+        if distance <= REORDER_WINDOW as u64 {
+            return self.ahead.insert(seq);
+        }
+        self.uncertain = true;
+        true
+    }
+}
