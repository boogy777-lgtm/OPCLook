+/// Result of a bounded replay attempt. Never implies history completeness.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RepublishRecoveryOutcome {
+    /// Server has no message for the next requested sequence.
+    MessageNotAvailable,
+    /// The bounded request budget was exhausted.
+    Exhausted,
+    /// The whole replay deadline elapsed.
+    Deadline,
+    /// The replay future was dropped before completion.
+    Cancelled,
+    /// A service or transport error interrupted replay.
+    Failed(opcua_types::StatusCode),
+    /// The returned sequence differed from the request.
+    SequenceMismatch,
+    /// Sequence ordering exceeded the supported window.
+    SequenceUncertain,
+    /// No prior delivered cursor was available.
+    NoCursor,
+}
+struct RecoveryGuard(tokio::sync::watch::Sender<Option<RepublishRecoveryOutcome>>, bool);
+impl RecoveryGuard {
+    fn finish(mut self, outcome: RepublishRecoveryOutcome) { self.0.send_replace(Some(outcome)); self.1 = false; }
+}
+impl Drop for RecoveryGuard { fn drop(&mut self) { if self.1 { self.0.send_replace(Some(RepublishRecoveryOutcome::Cancelled)); } } }
+
