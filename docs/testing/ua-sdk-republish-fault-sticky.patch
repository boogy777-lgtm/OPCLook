+#[cfg(test)]
+mod recovery_watch_overwrite_test {
+    use super::*;
+    #[test]
+    fn latest_watch_does_not_retain_cancelled_history() {
+        let (tx, mut rx) = tokio::sync::watch::channel(None);
+        RecoveryGuard(tx.clone(), true).finish(RepublishRecoveryOutcome::Cancelled);
+        RecoveryGuard(tx.clone(), true).finish(RepublishRecoveryOutcome::MessageNotAvailable);
+        assert_eq!(*rx.borrow_and_update(), Some(RepublishRecoveryOutcome::MessageNotAvailable));
+        assert!(!rx.has_changed().unwrap());
+    }
+}
