+// The SDK owns acknowledgements taken by an in-flight Publish. If its future
+// is cancelled before a response, return them to the SDK queue for a later
+// Publish; this also covers drop before the future is polled again.
+struct PendingPublishAcks<'a> {
+    state: &'a Mutex<SubscriptionState>,
+    acks: Option<Vec<(SubscriptionAcknowledgement, std::sync::Arc<()>)>>,
+}
+impl<'a> PendingPublishAcks<'a> {
+    fn take(state: &'a Mutex<SubscriptionState>) -> Self {
+        let acks = trace_lock!(state).take_scoped_acknowledgements();
+        Self { state, acks: Some(acks) }
+    }
+    fn items(&self) -> Vec<SubscriptionAcknowledgement> { self.acks.as_deref().unwrap_or_default().iter().map(|(ack,_)| ack.clone()).collect() }
+    fn commit(&mut self) { self.acks = None; }
+}
+impl Drop for PendingPublishAcks<'_> {
+    fn drop(&mut self) {
+        if let Some(acks) = self.acks.take() {
+            if !acks.is_empty() { trace_lock!(self.state).re_queue_scoped_acknowledgements(acks); }
+        }
+    }
+}
