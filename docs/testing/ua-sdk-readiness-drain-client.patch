+fn start_drain(generation:u64, session:Arc<Session>) -> RecoveryPhase {
+    RecoveryPhase::Draining(generation, async move {
+                                let single = session.subscription_state.lock().subscription_ids().map(|ids| ids.len() == 1).unwrap_or(false);
+                                if !single { return RecoveryDrainOutcome::UnsupportedSubscriptions; }
+                                match tokio::time::timeout(Duration::from_secs(5), async {
+                                    for _ in 0..64 {
+                                        match session.publish().await {
+                                            Ok(false) => return RecoveryDrainOutcome::Complete,
+                                            Ok(true) => (),
+                                            Err(error) => return RecoveryDrainOutcome::Failed(error.status()),
+                                        }
+                                    }
+                                    RecoveryDrainOutcome::Exhausted
+                                }).await { Ok(outcome) => outcome, Err(_) => RecoveryDrainOutcome::Deadline }
+    }.boxed())
+}
+enum RecoveryResult { Replay(u64, RepublishRecoveryOutcome), Drain(u64, RecoveryDrainOutcome) }
+
+// A single guard covers every nonterminal recovery phase. A terminal SDK
+// stream event disarms it; dropping the stream in any other phase cancels once.
+struct RecoveryControl {
+    phase: RecoveryPhase,
+    guard: Option<ReplayCancellationGuard>,
+}
