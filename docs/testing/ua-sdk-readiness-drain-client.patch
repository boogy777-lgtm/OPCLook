+#[cfg(test)]
+mod publish_cancel_regression {
+    use super::*;
+    use crate::session::services::subscriptions::PublishLimits;
+    use std::task::{Context, Poll};
+    use std::future::Future;
+    #[test]
+    fn pending_publish_guard_requeues_on_drop_once() {
+        let (tx, _rx)=tokio::sync::watch::channel(PublishLimits::new());
+        let state=Mutex::new(SubscriptionState::new(Duration::from_millis(1),tx));
+        use crate::session::services::subscriptions::{Subscription, MonitoredItemMap, callbacks::OnSubscriptionNotificationCore};
+        struct Sink;
+        impl OnSubscriptionNotificationCore for Sink { fn on_subscription_notification(&mut self, _:NotificationMessage, _:MonitoredItemMap<'_>) {} }
+        trace_lock!(state).add_subscription(Subscription::new(7,Duration::from_millis(100),10,5,10,0,true,Box::new(Sink)));
+        trace_lock!(state).add_acknowledgement(7,42);
+        let future=async {
+            let _pending=PendingPublishAcks::take(&state);
+            futures::future::pending::<()>().await;
+        };
+        let mut future=Box::pin(future);
+        let waker=futures::task::noop_waker();
+        let mut cx=Context::from_waker(&waker);
+        assert!(matches!(future.as_mut().poll(&mut cx),Poll::Pending));
+        assert!(trace_lock!(state).take_acknowledgements().is_empty());
+        drop(future);
+        let acks=trace_lock!(state).take_acknowledgements();
+        assert_eq!(acks.len(),1);
+        assert_eq!((acks[0].subscription_id,acks[0].sequence_number),(7,42));
+        assert!(trace_lock!(state).take_acknowledgements().is_empty());
+    }
+    #[test]
+    fn dropped_publish_does_not_ack_reused_subscription_id() {
+        use crate::session::services::subscriptions::{Subscription, MonitoredItemMap, callbacks::OnSubscriptionNotificationCore};
+        struct Sink;
+        impl OnSubscriptionNotificationCore for Sink { fn on_subscription_notification(&mut self, _:NotificationMessage, _:MonitoredItemMap<'_>) {} }
+        let (tx,_)=tokio::sync::watch::channel(PublishLimits::new());
+        let state=Mutex::new(SubscriptionState::new(Duration::from_millis(1),tx));
+        let make=|| Subscription::new(7,Duration::from_millis(100),10,5,10,0,true,Box::new(Sink));
+        trace_lock!(state).add_subscription(make());
+        trace_lock!(state).add_acknowledgement(7,42);
+        let pending=PendingPublishAcks::take(&state);
+        trace_lock!(state).delete_subscription(7);
+        trace_lock!(state).add_subscription(make());
+        drop(pending);
+        assert!(trace_lock!(state).take_acknowledgements().is_empty());
+    }
+
+}
