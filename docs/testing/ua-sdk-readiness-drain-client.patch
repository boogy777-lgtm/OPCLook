+    fn new(phase:RecoveryPhase, outcome:tokio::sync::watch::Sender<Option<RepublishRecoveryOutcome>>) -> Self {
+        let guard = if matches!(phase,RecoveryPhase::Normal) { None } else { Some(ReplayCancellationGuard { outcome,armed:true }) };
+        Self { phase,guard }
+    }
+    fn terminal(&mut self) { if let Some(mut guard)=self.guard.take() { guard.armed=false; } }
+}
