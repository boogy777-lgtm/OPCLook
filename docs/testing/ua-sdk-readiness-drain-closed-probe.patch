+#[test]
+fn sdk_ready_deadline_and_transport_loss_reject_late_ack() {
+    use opcua::client::{DataChangeCallback, RecoveryReadyPhase, RepublishRecoveryOutcome};
+    use opcua::types::{AttributeId, MonitoredItemCreateRequest, MonitoringMode, MonitoringParameters, ReadValueId, TimestampsToReturn};
+    let server=TestServer::start(free_port());let proxy=RecoveryProxy::start(&server);
+    let rt=tokio::runtime::Builder::new_multi_thread().worker_threads(2).enable_all().build().unwrap();
+    rt.block_on(async {
+        let (events,_event_rx)=channel();let cancel=tokio_util::sync::CancellationToken::new();
+        let mut adapter=super::session::connect(SessionId::FIRST,Some(crate::bff::model::RequestId::FIRST),Harness::endpoint(&proxy.url),&cancel,&events).await.unwrap();
+        let mut ready=adapter.session.subscribe_recovery_readiness();let mut outcome=adapter.session.subscribe_republish_recovery();
+        let node=ReadValueId {node_id:NodeId::new(server.ns,"Level"),attribute_id:AttributeId::Value as u32,..Default::default()};
+        let (tx,rx)=channel();let callback=DataChangeCallback::new(move |v:DataValue,_|{let _=tx.send(v);});
+        let sub=adapter.session.create_subscription(Duration::from_millis(100),100,20,1000,0,true,callback).await.unwrap();
+        let items=adapter.session.create_monitored_items(sub,TimestampsToReturn::Both,vec![MonitoredItemCreateRequest {item_to_monitor:node.clone(),monitoring_mode:MonitoringMode::Reporting,requested_parameters:MonitoringParameters {client_handle:1,sampling_interval:0.0,queue_size:10,discard_oldest:true,..Default::default()}}]).await.unwrap();assert!(items[0].result.status_code.is_good());
+        rx.recv_timeout(Duration::from_secs(15)).expect("initial callback");
+        proxy.cut.send_modify(|n|*n+=1);
+        tokio::time::timeout(Duration::from_secs(30),ready.changed()).await.expect("first readiness").unwrap();
+        let first=*ready.borrow_and_update();assert_eq!(first.phase,RecoveryReadyPhase::Waiting);
+        assert!(!adapter.session.confirm_recovery_readiness(first.generation+1));
+        tokio::time::timeout(Duration::from_secs(10),outcome.changed()).await.expect("deadline outcome").unwrap();
+        assert_eq!(*outcome.borrow_and_update(),Some(RepublishRecoveryOutcome::ReadinessDeadline));
+        assert!(!adapter.session.confirm_recovery_readiness(first.generation));
+        server.set("Level",Variant::Double(65.5));
+        let read=adapter.session.read(&[node],TimestampsToReturn::Both,0.0).await.expect("network after deadline");assert_eq!(read[0].value,Some(Variant::Double(65.5)));
+        assert!(rx.recv_timeout(Duration::from_secs(1)).is_err(), "timeout must not deliver callback to unready consumer");
+        let _=*ready.borrow_and_update();
+        proxy.cut.send_modify(|n|*n+=1);
+        tokio::time::timeout(Duration::from_secs(30),ready.changed()).await.expect("second readiness").unwrap();
+        let second=*ready.borrow_and_update();assert_eq!(second.phase,RecoveryReadyPhase::Waiting);assert!(second.generation>first.generation);
+        assert!(!adapter.session.confirm_recovery_readiness(first.generation));
+        proxy.cut.send_modify(|n|*n+=1);
+        tokio::time::timeout(Duration::from_secs(10),outcome.changed()).await.expect("cancel outcome").unwrap();
+        assert_eq!(*outcome.borrow_and_update(),Some(RepublishRecoveryOutcome::Cancelled));
+        assert!(!adapter.session.confirm_recovery_readiness(second.generation));
+        assert!(adapter.session.republish_history_uncertain());
+        eprintln!("OBSERVED ready_timeout=typed late_ack=rejected loss_cancel=typed stale_ack=rejected network_after_deadline=ok unready_callback=none");
+        adapter.close().await;
+    });
+}
