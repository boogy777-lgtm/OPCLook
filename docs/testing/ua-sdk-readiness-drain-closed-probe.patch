+#[test]
+fn sdk_ready_simultaneous_ack_and_closed_prioritizes_loss() {
+    use opcua::client::{RecoveryReadyPhase, RepublishRecoveryOutcome};
+    let dir=PathBuf::from(std::env::var_os("OPCLOOK_TEST_SELECT_BARRIER").expect("barrier dir"));
+    let server=TestServer::start(free_port());let proxy=RecoveryProxy::start(&server);
+    let rt=tokio::runtime::Builder::new_multi_thread().worker_threads(2).enable_all().build().unwrap();
+    rt.block_on(async {
+        let (events,_)=channel();let cancel=tokio_util::sync::CancellationToken::new();
+        let mut adapter=super::session::connect(SessionId::FIRST,Some(crate::bff::model::RequestId::FIRST),Harness::endpoint(&proxy.url),&cancel,&events).await.unwrap();
+        let mut ready=adapter.session.subscribe_recovery_readiness();let mut outcome=adapter.session.subscribe_republish_recovery();
+        while proxy.closed.try_recv().is_ok() {}
+        proxy.cut.send_modify(|n|*n+=1);
+        tokio::time::timeout(Duration::from_secs(30),ready.changed()).await.expect("readiness request").unwrap();
+        let current=*ready.borrow_and_update();assert_eq!(current.phase,RecoveryReadyPhase::Waiting);
+        let deadline=Instant::now()+Duration::from_secs(5);
+        while !dir.join("entered").exists() {assert!(Instant::now()<deadline,"SDK select barrier");tokio::time::sleep(Duration::from_millis(1)).await;}
+        while proxy.closed.try_recv().is_ok() {}
+        proxy.cut.send_modify(|n|*n+=1);proxy.closed.recv_timeout(Duration::from_secs(5)).expect("proxy closed active connection");
+        assert!(adapter.session.confirm_recovery_readiness(current.generation));
+        std::fs::write(dir.join("release"),b"go").unwrap();
+        tokio::time::timeout(Duration::from_secs(10),outcome.changed()).await.expect("loss outcome").unwrap();
+        assert_eq!(*outcome.borrow_and_update(),Some(RepublishRecoveryOutcome::Cancelled),"ready connection loss must win over ready acknowledgement");
+        assert!(!adapter.session.confirm_recovery_readiness(current.generation));
+        eprintln!("OBSERVED simultaneous_ack_closed=Cancelled stale_ack=rejected");
+        adapter.close().await;
+    });
+}
