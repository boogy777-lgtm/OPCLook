+    fn drop_unpolled_replay_reports_cancelled() {
+        let (tx, rx) = tokio::sync::watch::channel(None);
+        let future=guarded_replay(futures::future::pending(),tx);
+        drop(future);
+        assert_eq!(*rx.borrow(),Some(RepublishRecoveryOutcome::Cancelled));
+    }
+    #[test]
+    fn ready_transport_cannot_hide_expired_deadline() {
+        let now=Instant::now();
+        let waiting=RecoveryPhase::Waiting(1,true,now);
+        assert!(recovery_wait_expired(&waiting,now));
+        assert!(!recovery_wait_expired(&waiting,now-std::time::Duration::from_millis(1)));
+        assert!(!recovery_wait_expired(&RecoveryPhase::Failed,now));
+    }
+    #[test]
+    fn confirmed_ack_is_not_overwritten_by_stale_timeout() {
+        let deadline=Instant::now();
+        let (tx,rx)=tokio::sync::watch::channel(RecoveryReadiness {generation:7,phase:RecoveryReadyPhase::Waiting,deadline});
+        let stale=*rx.borrow();
+        assert_eq!(stale.phase,RecoveryReadyPhase::Waiting);
+        tx.send_modify(|r| r.phase=RecoveryReadyPhase::Confirmed);
+        assert!(!expire_waiting(&tx,7,|| deadline));
+        assert_eq!(rx.borrow().phase,RecoveryReadyPhase::Confirmed);
+    }
+    #[test]
+    fn replay_cancellation_publishes_once() {
+        let (tx,mut rx)=tokio::sync::watch::channel(None);
+        let phase=RecoveryPhase::Replaying(guarded_replay(futures::future::pending(),tx.clone()));
+        cancel_recovery_phase(&phase,&tx);
+        assert!(!rx.has_changed().unwrap(), "replay guard owns cancellation");
+        drop(phase);
+        assert!(rx.has_changed().unwrap());
+        assert_eq!(*rx.borrow_and_update(),Some(RepublishRecoveryOutcome::Cancelled));
+        assert!(!rx.has_changed().unwrap(), "one cancellation transition");
+    }
