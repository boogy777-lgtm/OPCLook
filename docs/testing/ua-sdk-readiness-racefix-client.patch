+fn guarded_replay<F>(future: F, outcome: tokio::sync::watch::Sender<Option<RepublishRecoveryOutcome>>) -> BoxFuture<'static, RepublishRecoveryOutcome>
+where F: std::future::Future<Output=RepublishRecoveryOutcome> + Send + 'static {
+    let guard = ReplayCancellationGuard { outcome, armed: true };
+    async move {
+        let mut guard = guard;
+        let result = future.await;
+        guard.armed = false;
+        result
+    }.boxed()
+}
