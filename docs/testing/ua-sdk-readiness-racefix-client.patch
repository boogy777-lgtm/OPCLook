+}
+
+fn recovery_wait_expired(phase: &RecoveryPhase, now: Instant) -> bool {
+    matches!(phase, RecoveryPhase::Waiting(_, _, deadline) if now >= *deadline)
+}
+fn is_confirmed(phase: &RecoveryPhase, ready: RecoveryReadiness) -> bool {
+    matches!(phase, RecoveryPhase::Waiting(generation, _, _) if *generation == ready.generation && ready.phase == RecoveryReadyPhase::Confirmed)
+}
+// Decide expiry while holding the same lock used by confirmation. A confirmed
+// generation cannot be overwritten by a timeout based on a stale snapshot.
+fn expire_waiting<C: FnOnce() -> Instant>(tx: &tokio::sync::watch::Sender<RecoveryReadiness>, generation: u64, clock: C) -> bool {
+    let mut expired = false;
+    let mut clock = Some(clock);
+    tx.send_if_modified(|ready| {
+        if ready.generation == generation && ready.phase == RecoveryReadyPhase::Waiting && clock.take().unwrap()() >= ready.deadline {
+            ready.phase = RecoveryReadyPhase::Inactive;
+            expired = true;
+            true
+        } else { false }
+    });
+    expired
+}
+fn cancel_recovery_phase(phase: &RecoveryPhase, outcome: &tokio::sync::watch::Sender<Option<RepublishRecoveryOutcome>>) {
+    if matches!(phase, RecoveryPhase::Announce(..) | RecoveryPhase::Waiting(..)) {
+        outcome.send_replace(Some(RepublishRecoveryOutcome::Cancelled));
+    }
+    // Replaying owns a drop guard and publishes cancellation once on drop.
+}
+fn advance_confirmed(phase: &mut RecoveryPhase, ready: RecoveryReadiness, session: Arc<Session>) -> bool {
+    let (generation, same_session, deadline) = match phase {
+        RecoveryPhase::Waiting(generation, same_session, deadline) if *generation == ready.generation && ready.phase == RecoveryReadyPhase::Confirmed => (*generation,*same_session,*deadline),
+        _ => return false,
+    };
+    session.recovery_ready_tx.send_replace(RecoveryReadiness { generation, phase: RecoveryReadyPhase::Inactive, deadline });
+    if same_session {
+        let outcome_tx=session.republish_outcome_tx.clone();
+        *phase=RecoveryPhase::Replaying(guarded_replay(async move {
+            match tokio::time::timeout(Duration::from_secs(5),session.recovery_republish_prototype()).await {
+                Ok(result)=>result,
+                Err(_)=>RepublishRecoveryOutcome::Deadline,
+            }
+        },outcome_tx));
+    } else {
+        *phase=RecoveryPhase::Normal;
+        session.republish_outcome_tx.send_replace(Some(RepublishRecoveryOutcome::NewSessionUnreplayed));
+    }
+    true
