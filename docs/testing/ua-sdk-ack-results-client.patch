+    /// Bounded Publish ACK observations, scoped to this Session object.
+    /// A summary does not imply notification or history completeness. This ACK
+    /// flag is separate from `republish_history_uncertain`. Query outside SDK
+    /// notification callbacks (which hold the subscription mutex) and outside
+    /// backend identity locks to avoid lock re-entry and lock-order deadlocks.
+    pub fn publish_ack_observations(&self) -> PublishAckObservations {
+        let state = self.subscription_state.lock();
+        PublishAckObservations {
+            latest: state.ack_result_latest.clone(),
+            uncertain: state.ack_result_uncertain,
+        }
+    }
+
