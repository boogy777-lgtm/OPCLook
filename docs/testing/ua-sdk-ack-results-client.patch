+
+#[cfg(test)]
+mod ack_results_regression {
+    use super::*;
+    use crate::session::services::subscriptions::{MonitoredItemMap, PublishLimits, Subscription};
+    use std::sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    };
+    struct Sink(Arc<AtomicUsize>);
+    impl OnSubscriptionNotificationCore for Sink {
+        fn on_subscription_notification(
+            &mut self,
+            notification: NotificationMessage,
+            _: MonitoredItemMap<'_>,
+        ) {
+            assert_eq!(notification.sequence_number, 44);
+            assert_eq!(
+                notification.notification_data,
+                Some(vec![ExtensionObject::null()])
+            );
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+    fn run(
+        results: Option<Vec<StatusCode>>,
+        sent: usize,
+    ) -> (Option<PublishAckSummary>, bool, usize, bool) {
+        let (tx, _rx) = tokio::sync::watch::channel(PublishLimits::new());
+        let state = Mutex::new(SubscriptionState::new(Duration::from_millis(1), tx));
+        let callbacks = Arc::new(AtomicUsize::new(0));
+        {
+            let mut state = trace_lock!(state);
+            state.add_subscription(Subscription::new(
+                7,
+                Duration::from_millis(100),
+                10,
+                5,
+                10,
+                0,
+                true,
+                Box::new(Sink(callbacks.clone())),
+            ));
+            for n in 0..sent {
+                state.add_acknowledgement(7, n as u32 + 10);
+            }
+        }
+        let mut pending = PendingPublishAcks::take(&state);
+        let response = PublishResponse {
+            results,
+            subscription_id: 7,
+            more_notifications: true,
+            notification_message: NotificationMessage {
+                sequence_number: 44,
+                notification_data: Some(vec![ExtensionObject::null()]),
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        let more = process_publish_response(&mut pending, response);
+        drop(pending);
+        let mut state = trace_lock!(state);
+        let new_acks = state.take_acknowledgements();
+        assert_eq!(
+            new_acks.len(),
+            1,
+            "only the new notification is acknowledged"
+        );
+        assert_eq!(
+            (new_acks[0].subscription_id, new_acks[0].sequence_number),
+            (7, 44)
+        );
+        (
+            state.ack_result_latest.clone(),
+            state.ack_result_uncertain,
+            callbacks.load(Ordering::SeqCst),
+            more,
+        )
+    }
+    #[test]
+    fn response_results_do_not_hide_uncertainty_or_drop_callback() {
+        let (summary, uncertain, callbacks, more) = run(
+            Some(vec![StatusCode::Good, StatusCode::BadSequenceNumberUnknown]),
+            2,
+        );
+        let summary = summary.expect("response summary");
+        assert_eq!(
+            (
+                summary.sent,
+                summary.exact_good,
+                summary.non_exact,
+                summary.missing,
+                summary.excess
+            ),
+            (2, 1, 1, 0, 0)
+        );
+        assert_eq!(
+            summary.first_issue,
+            Some(PublishAckIssue {
+                subscription_id: 7,
+                sequence_number: 11,
+                status: Some(StatusCode::BadSequenceNumberUnknown)
+            })
+        );
+        assert!(uncertain);
+        assert_eq!(callbacks, 1);
+        assert!(more);
+    }
+    #[test]
+    fn result_shapes_and_special_good_remain_distinct() {
+        let cases = [
+            (None, 0, (0, 0, 0, 0), false, None),
+            (Some(vec![StatusCode::Good]), 1, (1, 0, 0, 0), false, None),
+            (
+                Some(vec![StatusCode::GoodRetransmissionQueueNotSupported]),
+                1,
+                (0, 1, 0, 0),
+                true,
+                Some(Some(StatusCode::GoodRetransmissionQueueNotSupported)),
+            ),
+            (None, 2, (0, 0, 2, 0), true, Some(None)),
+            (
+                Some(vec![StatusCode::Good]),
+                2,
+                (1, 0, 1, 0),
+                true,
+                Some(None),
+            ),
+            (
+                Some(vec![StatusCode::Good, StatusCode::Good]),
+                1,
+                (1, 0, 0, 1),
+                true,
+                None,
+            ),
+            (
+                Some(vec![StatusCode::BadSubscriptionIdInvalid]),
+                1,
+                (0, 1, 0, 0),
+                true,
+                Some(Some(StatusCode::BadSubscriptionIdInvalid)),
+            ),
+            (
+                Some(vec![StatusCode::Uncertain]),
+                1,
+                (0, 1, 0, 0),
+                true,
+                Some(Some(StatusCode::Uncertain)),
+            ),
+        ];
+        for (results, sent, expected, uncertain, first_status) in cases {
+            let (summary, actual_uncertain, callbacks, more) = run(results, sent);
+            let summary = summary.expect("response summary");
+            assert_eq!(
+                (
+                    summary.exact_good,
+                    summary.non_exact,
+                    summary.missing,
+                    summary.excess
+                ),
+                expected
+            );
+            assert_eq!(
+                summary.first_issue.as_ref().map(|issue| issue.status),
+                first_status
+            );
+            assert_eq!(actual_uncertain, uncertain);
+            assert_eq!(callbacks, 1);
+            assert!(more);
+        }
+    }
+    #[test]
+    fn later_good_summary_does_not_erase_uncertainty() {
+        let (tx, _rx) = tokio::sync::watch::channel(PublishLimits::new());
+        let state = Mutex::new(SubscriptionState::new(Duration::from_millis(1), tx));
+        let callbacks = Arc::new(AtomicUsize::new(0));
+        trace_lock!(state).add_subscription(Subscription::new(
+            7,
+            Duration::from_millis(100),
+            10,
+            5,
+            10,
+            0,
+            true,
+            Box::new(Sink(callbacks.clone())),
+        ));
+        for status in [StatusCode::BadSequenceNumberUnknown, StatusCode::Good] {
+            trace_lock!(state).add_acknowledgement(7, 10);
+            let mut pending = PendingPublishAcks::take(&state);
+            let response = PublishResponse {
+                results: Some(vec![status]),
+                subscription_id: 7,
+                notification_message: NotificationMessage {
+                    sequence_number: 44,
+                    notification_data: Some(vec![ExtensionObject::null()]),
+                    ..Default::default()
+                },
+                ..Default::default()
+            };
+            process_publish_response(&mut pending, response);
+            drop(pending);
+            trace_lock!(state).take_acknowledgements();
+        }
+        let state = trace_lock!(state);
+        assert!(state.ack_result_uncertain);
+        assert_eq!(
+            state.ack_result_latest.as_ref().map(|s| s.exact_good),
+            Some(1)
+        );
+    }
+}
