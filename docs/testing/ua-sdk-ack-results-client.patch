+/// First ACK in a response for which exact acceptance was not observed.
+#[derive(Debug, Clone, PartialEq)]
+pub struct PublishAckIssue {
+    /// Server subscription ID at the time of the request.
+    pub subscription_id: u32,
+    /// Sequence number at the time of the request.
+    pub sequence_number: u32,
+    /// Raw status, or None if this position was missing.
+    pub status: Option<StatusCode>,
+}
+
+/// Bounded description of one Publish response, not retained event history.
+#[derive(Debug, Clone, PartialEq)]
+pub struct PublishAckSummary {
+    /// Number of ACKs sent.
+    pub sent: usize,
+    /// Number of matching exact Good statuses.
+    pub exact_good: usize,
+    /// Matching statuses other than exact Good, including Good subcodes.
+    pub non_exact: usize,
+    /// Sent ACKs without a matching status.
+    pub missing: usize,
+    /// Results without a matching sent ACK.
+    pub excess: usize,
+    /// First non-exact or missing ACK, if any.
+    pub first_issue: Option<PublishAckIssue>,
+}
+
+/// Latest summary and lifetime-sticky uncertainty for this SDK Session object.
+#[derive(Debug, Clone, PartialEq)]
+pub struct PublishAckObservations {
+    /// Most recently processed response, possibly superseding an earlier one.
+    pub latest: Option<PublishAckSummary>,
+    /// At least one non-exact or malformed result has been observed.
+    pub uncertain: bool,
+}
+
+fn process_publish_response(
+    pending: &mut PendingPublishAcks<'_>,
+    response: PublishResponse,
+) -> bool {
+    let sent = pending.items();
+    let results = response.results.as_deref().unwrap_or_default();
+    let mut summary = PublishAckSummary {
+        sent: sent.len(),
+        exact_good: 0,
+        non_exact: 0,
+        missing: sent.len().saturating_sub(results.len()),
+        excess: results.len().saturating_sub(sent.len()),
+        first_issue: None,
+    };
+    for (index, ack) in sent.iter().enumerate() {
+        let status = results.get(index).copied();
+        if status == Some(StatusCode::Good) {
+            summary.exact_good += 1;
+        } else {
+            if status.is_some() {
+                summary.non_exact += 1;
+            }
+            if summary.first_issue.is_none() {
+                summary.first_issue = Some(PublishAckIssue {
+                    subscription_id: ack.subscription_id,
+                    sequence_number: ack.sequence_number,
+                    status,
+                });
+            }
+            if let Some(status) = status {
+                if !status.is_good() && status != StatusCode::BadSequenceNumberUnknown {
+                    tracing::warn!(
+                        "Server rejected ack for subscription {} seq {}: {status}",
+                        ack.subscription_id,
+                        ack.sequence_number
+                    );
+                }
+            }
+        }
+    }
+    // A response may have been processed by the server even for a non-exact
+    // result. Do not automatically retry; preserve the existing callback path.
+    pending.commit();
+    let mut state = trace_lock!(pending.state);
+    state.ack_result_uncertain |=
+        summary.non_exact != 0 || summary.missing != 0 || summary.excess != 0;
+    state.ack_result_latest = Some(summary);
+    state.handle_notification(response.subscription_id, response.notification_message);
+    response.more_notifications
+}
